# ── 1. Environment & Secret Credentials (NEVER COMMIT) ────────────────────────
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Secret Keys, Certificates & Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.token
secrets.json
*credentials.json
*client_secret*.json
serviceAccountKey*.json

