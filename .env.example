# ==============================================================================
# ZytaSafe — Zero-Trust PCI Voice Intercept & Live Support Copilot
# Environment Variables & AI Model Configuration Guide (.env.example)
# Copy this file to .env and configure your private credentials
# ==============================================================================

# ── 1. Database & Infrastructure Credentials ──────────────────────────────────
POSTGRES_USER=zytasafe
POSTGRES_PASSWORD=your_strong_db_password_here
POSTGRES_DB=zytasafe_db
LIVEKIT_API_KEY=your_livekit_key_here
LIVEKIT_API_SECRET=your_livekit_secret_here

# Database connection URL for backend
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}
PAYMENT_SERVICE_URL=http://localhost:8001
LIVEKIT_URL=http://localhost:7880

# ── 2. Copilot Control Plane (Backend: Port 8000) ─────────────────────────────
# COPILOT_PROVIDER can be 'local' (offline keyword + document matching) or 'external'
COPILOT_PROVIDER=local

# Optional External Copilot AI Model (Meta Model API / Muse Spark Open on Baseten)
# Activated ONLY when COPILOT_PROVIDER=external
META_MODEL_API_KEY=
META_MODEL_ENDPOINT=https://api.meta.ai/v1/chat/completions
BASETEN_API_KEY=
BASETEN_MODEL_ID=

# ── 3. Isolated Payment Microservice (Data Plane: Port 8001) ─────────────────
# Enforces strict VPC isolation. NEVER connects to outside AI models.
PCI_SCOPE=ISOLATED

# Speech-to-Text (STT) Model: Whisper runs locally in-memory on CPU/GPU
WHISPER_MODEL=tiny

# Optional: Private self-hosted LLM (Muse Glimmer 30B on Modal / vLLM inside Client VPC)
# In production, this points to the client's own private GPU container, never public AI
MODAL_VLLM_ENDPOINT=
MODAL_API_KEY=

# ── 4. Frontend Desktop (React + Vite: Port 3000) ────────────────────────────
BACKEND_URL=http://localhost:8000
PAYMENT_URL=http://localhost:8001
