# ==============================================================================
# ZytaSafe — Zero-Trust PCI Voice Intercept & Live Support Copilot
# Meta Global AI Developer Hackathon · Startup Track · Theme: Build for Your World
# Environment Variables & AI Model Configuration Guide (.env.example)
#
# RULE: Every model the product calls at runtime is a Meta model.
# Browser and operating system features (built-in voice, Web Audio flatline)
# are not model calls.
# ==============================================================================

# ── 1. Database & Infrastructure Credentials ──────────────────────────────────
POSTGRES_USER=zytasafe
POSTGRES_PASSWORD=your_strong_db_password_here
POSTGRES_DB=zytasafe_db
LIVEKIT_API_KEY=your_livekit_key_here
LIVEKIT_API_SECRET=your_livekit_secret_here

# Database connection URL for backend (PostgreSQL built-in Full-Text Search)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}
PAYMENT_SERVICE_URL=http://localhost:8001
LIVEKIT_URL=http://localhost:7880

# ── 2. Copilot Control Plane (Backend: Port 8000) ─────────────────────────────
# Primary Brain: Muse Spark Open on Baseten (Document retrieval + structured suggestions)
COPILOT_PROVIDER=spark_open

# Outside Provider Adapter: Controlled by API_ACTIVE (false by default so no outside call is made)
API_ACTIVE=false
META_MODEL_API_KEY=
META_MODEL_ENDPOINT=https://api.meta.ai/v1/chat/completions
BASETEN_API_KEY=
BASETEN_SPARK_OPEN_URL=https://model-spark-open.baseten.co/predict

# ── 3. Isolated Payment Microservice (Data Plane: Port 8001) ─────────────────
# Enforces strict VPC isolation. NEVER connects to outside AI models.
PCI_SCOPE=ISOLATED

# Speech-to-Text: Muse Spark Open Audio Input (turns speech into text in short clips).
# Fallback STT: Meta wav2vec 2.0 (self-hosted CPU/GPU inside client VPC).
META_STT_ENGINE=spark_open_audio
META_WAV2VEC_MODEL=facebook/wav2vec2-base-960h

# Text-to-Speech (Voice Output): Meta MMS (Massively Multilingual Speech) TTS.
# Fallback: Browser Web Speech API local voice (browser feature, not an AI model call).
META_TTS_MODEL=facebook/mms-tts-eng

# Optional Alternative: Muse Glimmer 30B on Modal (served through vLLM/SGLang)
MODAL_VLLM_ENDPOINT=
MODAL_API_KEY=

# ── 4. Frontend Desktop (React + Vite: Port 3000) ────────────────────────────
BACKEND_URL=http://localhost:8000
PAYMENT_URL=http://localhost:8001
